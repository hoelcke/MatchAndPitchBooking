    <bpmn:sequenceFlow id="Flow_Planbokning_5" sourceRef="B_Review" targetRef="B_Decide" />
    <bpmn:sequenceFlow id="Flow_Planbokning_6" name="Ja" sourceRef="B_Decide" targetRef="B_Allocate" />
    <bpmn:sequenceFlow id="Flow_Planbokning_7" name="Nej" sourceRef="B_Decide" targetRef="B_Reject" />
    <bpmn:sequenceFlow id="Flow_Planbokning_8" sourceRef="B_Allocate" targetRef="B_Reserved" />
    <bpmn:sequenceFlow id="Flow_Planbokning_9" sourceRef="B_Reject" targetRef="B_Rejected" />
