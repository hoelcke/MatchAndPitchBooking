      <dmndi:DMNShape id="helgtid_di" dmnElementRef="helgtid"><dc:Bounds height="80" width="180" x="300" y="260" /></dmndi:DMNShape>
      <dmndi:DMNShape id="skapaMatch_di" dmnElementRef="skapaMatch"><dc:Bounds height="80" width="180" x="300" y="80" /></dmndi:DMNShape>
      <dmndi:DMNShape id="kompatibel_di" dmnElementRef="kompatibel"><dc:Bounds height="80" width="180" x="650" y="260" /></dmndi:DMNShape>
      <dmndi:DMNShape id="anmalan_di" dmnElementRef="anmalan"><dc:Bounds height="80" width="180" x="800" y="80" /></dmndi:DMNShape>
      <dmndi:DMNShape id="avbokning_di" dmnElementRef="avbokning"><dc:Bounds height="80" width="180" x="1000" y="80" /></dmndi:DMNShape>
      <dmndi:DMNShape id="recension_di" dmnElementRef="recension"><dc:Bounds height="80" width="180" x="1250" y="80" /></dmndi:DMNShape>
      <dmndi:DMNShape id="lagprofil_di" dmnElementRef="lagprofil"><dc:Bounds height="80" width="180" x="1500" y="80" /></dmndi:DMNShape>
      <dmndi:DMNShape id="planErbjuds_di" dmnElementRef="planErbjuds"><dc:Bounds height="80" width="180" x="1250" y="400" /></dmndi:DMNShape>
      <dmndi:DMNShape id="akut_di" dmnElementRef="akut"><dc:Bounds height="80" width="180" x="1500" y="400" /></dmndi:DMNShape>
