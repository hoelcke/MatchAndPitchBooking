    <bpmn:sequenceFlow id="Flow_Planbokning_13" sourceRef="B_Remind" targetRef="B_EndRemind" />
    <bpmn:sequenceFlow id="Flow_Planbokning_14" sourceRef="B_Timer14" targetRef="B_Revoked" />
    <bpmn:sequenceFlow id="Flow_Planbokning_15" sourceRef="B_Revoked" targetRef="B_EndRevoked" />
    <bpmn:sequenceFlow id="Flow_Planbokning_16" sourceRef="B_MsgWithdrawn" targetRef="B_EndWithdrawn" />
    <bpmn:sequenceFlow id="Flow_Planbokning_17" sourceRef="B_WaitAccept" targetRef="B_Lock" />
    <bpmn:sequenceFlow id="Flow_Planbokning_18" sourceRef="B_Lock" targetRef="B_WaitOutcome" />
    <bpmn:sequenceFlow id="Flow_Planbokning_19" sourceRef="B_WaitOutcome" targetRef="B_MatchCompleted" />
    <bpmn:sequenceFlow id="Flow_Planbokning_20" sourceRef="B_WaitOutcome" targetRef="B_MatchExpired" />
