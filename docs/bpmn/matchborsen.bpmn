<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Matchborsen" targetNamespace="https://github.com/hoelcke/MatchAndPitchBooking" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_Matchborsen">
    <bpmn:documentation>Matchbörsen &amp; Planbokning, IFK Lidingö. Tre processer som kommunicerar via händelser i en intern outbox (kravspecifikation v1.1.1, avsnitt 4.0). Dokumentation, inte körbar: appen har en egen processmotor.</bpmn:documentation>
    <bpmn:participant id="Participant_Match" name="Match (Process A)" processRef="Process_Match" />
    <bpmn:participant id="Participant_Planbokning" name="Planbokning (Process B)" processRef="Process_Planbokning" />
    <bpmn:participant id="Participant_FairPlay" name="Fair Play (Process C)" processRef="Process_FairPlay" />
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="A_Request" targetRef="B_Start" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="B_Reserved" targetRef="A_Reserved" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="B_Rejected" targetRef="A_Rejected" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="A_Accepted" targetRef="B_WaitAccept" />
    <bpmn:messageFlow id="MessageFlow_5" sourceRef="B_Revoked" targetRef="A_MsgRevoked" />
    <bpmn:messageFlow id="MessageFlow_6" sourceRef="Participant_Planbokning" targetRef="A_MsgOffice" />
    <bpmn:messageFlow id="MessageFlow_7" sourceRef="Participant_Match" targetRef="B_MsgWithdrawn" />
    <bpmn:messageFlow id="MessageFlow_8" sourceRef="A_Completed" targetRef="B_MatchCompleted" />
    <bpmn:messageFlow id="MessageFlow_9" sourceRef="A_Completed" targetRef="C_Start" />
    <bpmn:messageFlow id="MessageFlow_10" sourceRef="A_Expired" targetRef="B_MatchExpired" />
  </bpmn:collaboration>
  <bpmn:message id="Message_REQUEST_RESERVATION" name="REQUEST_RESERVATION" />
  <bpmn:message id="Message_RESERVATION_RESERVED" name="RESERVATION_RESERVED" />
  <bpmn:message id="Message_RESERVATION_REJECTED" name="RESERVATION_REJECTED" />
  <bpmn:message id="Message_RESERVATION_ACCEPTED" name="RESERVATION_ACCEPTED" />
  <bpmn:message id="Message_RESERVATION_WITHDRAWN" name="RESERVATION_WITHDRAWN" />
  <bpmn:message id="Message_RESERVATION_REVOKED" name="RESERVATION_REVOKED" />
  <bpmn:message id="Message_RESERVATION_CANCELLED_BY_OFFICE" name="RESERVATION_CANCELLED_BY_OFFICE" />
  <bpmn:message id="Message_MATCH_COMPLETED" name="MATCH_COMPLETED" />
  <bpmn:message id="Message_MATCH_EXPIRED" name="MATCH_EXPIRED" />
  <bpmn:message id="Message_REVIEW_AGGREGATED" name="REVIEW_AGGREGATED" />
  <bpmn:message id="Message_WITHDRAW_AS_OPPONENT" name="WITHDRAW_AS_OPPONENT" />
  <bpmn:process id="Process_Match" name="Match (Process A)" isExecutable="false">
    <bpmn:documentation>Matchgenomförande, avsnitt 3.1. Kod: src/server/modules/matches.ts. Status: MatchStatus.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Match">
      <bpmn:lane id="Lane_A_Home" name="Hemmalag (lagledare IFK Lidingö)">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndNoOpponent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndRevoked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndOffice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndRemind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_TimerStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MsgRevoked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MsgOffice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_TimerRemind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Timer48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MsgWithdraw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_A_Away" name="Bortalag (lagledare)">
        <bpmn:flowNodeRef>A_Inquire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_A_System" name="System">
        <bpmn:flowNodeRef>A_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Weekend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_WaitOffice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Reserved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Market</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Republish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Ledaren vill skapa match"><bpmn:outgoing>Flow_Match_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="A_Fill" name="Fyll i matchuppgifter"><bpmn:documentation>A1, A2, AC-101.1, AC-101.3, BR-17. Datum, starttid och längd (60 min som standard), spelform, födelseår, kategori, nivå, domare, matchställ och telefon. Spår 2 väljer även plan.</bpmn:documentation><bpmn:incoming>Flow_Match_1</bpmn:incoming><bpmn:outgoing>Flow_Match_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A_Auth" name="Kontrollera behörighet"><bpmn:documentation>BR-07, BR-08, AC-101.5. Bara godkända ledare för IFK Lidingö-lag.</bpmn:documentation><bpmn:incoming>Flow_Match_2</bpmn:incoming><bpmn:outgoing>Flow_Match_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="A_Track" name="Spår?"><bpmn:documentation>FR-A-101. Spår 1 = ny helgtid via kansliet. Spår 2 = egen träningstid.</bpmn:documentation><bpmn:incoming>Flow_Match_3</bpmn:incoming><bpmn:outgoing>Flow_Match_4</bpmn:outgoing><bpmn:outgoing>Flow_Match_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A_Weekend" name="Kontrollera helg och 21 dagar"><bpmn:documentation>BR-01, BR-06, AC-101.2, AC-101.4.</bpmn:documentation><bpmn:incoming>Flow_Match_5</bpmn:incoming><bpmn:outgoing>Flow_Match_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="A_Request" name="REQUEST_RESERVATION"><bpmn:documentation>A1, 4.1. Matchen får status RESERVATION_REQUESTED.</bpmn:documentation><bpmn:incoming>Flow_Match_6</bpmn:incoming><bpmn:outgoing>Flow_Match_7</bpmn:outgoing><bpmn:messageEventDefinition id="A_Request_Def" messageRef="Message_REQUEST_RESERVATION" /></bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="A_WaitOffice" name="Vänta på kansliet"><bpmn:incoming>Flow_Match_7</bpmn:incoming><bpmn:outgoing>Flow_Match_8</bpmn:outgoing><bpmn:outgoing>Flow_Match_9</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="A_Reserved" name="RESERVATION_RESERVED"><bpmn:documentation>A3, AC-102.1. Plan och tid sätts på matchen.</bpmn:documentation><bpmn:incoming>Flow_Match_8</bpmn:incoming><bpmn:outgoing>Flow_Match_10</bpmn:outgoing><bpmn:messageEventDefinition id="A_Reserved_Def" messageRef="Message_RESERVATION_RESERVED" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A_Rejected" name="RESERVATION_REJECTED"><bpmn:documentation>A4. Hemmalaget får kansliets orsak (notis #5).</bpmn:documentation><bpmn:incoming>Flow_Match_9</bpmn:incoming><bpmn:outgoing>Flow_Match_11</bpmn:outgoing><bpmn:messageEventDefinition id="A_Rejected_Def" messageRef="Message_RESERVATION_REJECTED" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="A_EndRejected" name="Avbokad (avslag)"><bpmn:documentation>Status CANCELLED.</bpmn:documentation><bpmn:incoming>Flow_Match_11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="A_Merge"><bpmn:incoming>Flow_Match_4</bpmn:incoming><bpmn:incoming>Flow_Match_10</bpmn:incoming><bpmn:outgoing>Flow_Match_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A_Publish" name="Publicera på börsen"><bpmn:documentation>A2, A3, AC-102.2. Status PUBLISHED. Gäster ser matchen utan kontaktuppgifter.</bpmn:documentation><bpmn:incoming>Flow_Match_12</bpmn:incoming><bpmn:outgoing>Flow_Match_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="A_Market"><bpmn:incoming>Flow_Match_13</bpmn:incoming><bpmn:incoming>Flow_Match_26</bpmn:incoming><bpmn:outgoing>Flow_Match_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="A_Inquire" name="Anmäl intresse"><bpmn:documentation>AC-103.1, BR-09. Flera lag kan anmäla sig. Hemmalaget får e-post (notis #6). Anmälan kan dras tillbaka före valet (AC-103.3).</bpmn:documentation><bpmn:incoming>Flow_Match_14</bpmn:incoming><bpmn:outgoing>Flow_Match_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="A_Select" name="Välj motståndare"><bpmn:documentation>A6, BR-15, BR-16, AC-103.4. Status MATCH_CONFIRMED. Övriga anmälningar avvisas (notis #7, #8). I Spår 1 spärras valet efter 14-dagarsfristen (BR-03).</bpmn:documentation><bpmn:incoming>Flow_Match_15</bpmn:incoming><bpmn:outgoing>Flow_Match_19</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="A_EndNoOpponent" name="Utgången (ingen motståndare)"><bpmn:documentation>A12, AC-106.1. Status EXPIRED. Spår 1 med accepterad bokning: MATCH_EXPIRED (NO_OPPONENT_AT_START).</bpmn:documentation><bpmn:incoming>Flow_Match_16</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="A_EndRevoked" name="Inställd (14-dagarsfristen)"><bpmn:documentation>A10. Status CANCELLED. Notis #12.</bpmn:documentation><bpmn:incoming>Flow_Match_17</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="A_EndOffice" name="Inställd av kansliet"><bpmn:documentation>A11. Status CANCELLED. Akut notis #13 med kansliets orsak. Gäller även MATCH_CONFIRMED.</bpmn:documentation><bpmn:incoming>Flow_Match_18</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="A_Accepted" name="RESERVATION_ACCEPTED (Spår 1)"><bpmn:documentation>4.4, BR-04. Skickas bara i Spår 1, och igen vid ny motståndare efter återbud.</bpmn:documentation><bpmn:incoming>Flow_Match_19</bpmn:incoming><bpmn:outgoing>Flow_Match_20</bpmn:outgoing><bpmn:messageEventDefinition id="A_Accepted_Def" messageRef="Message_RESERVATION_ACCEPTED" /></bpmn:intermediateThrowEvent>
    <bpmn:userTask id="A_Confirm" name="Bekräfta &quot;Match genomförd&quot;"><bpmn:documentation>A13, BR-14. Tillåtet från sluttid till 48 timmar efter sluttid.</bpmn:documentation><bpmn:incoming>Flow_Match_20</bpmn:incoming><bpmn:outgoing>Flow_Match_27</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A_Republish" name="Återpublicera med röd flagga"><bpmn:documentation>A7, AC-104.2, BR-04. Status PUBLISHED, isUrgent. Akut notis #9 till hemmalaget. Inget event till Planbokning.</bpmn:documentation><bpmn:incoming>Flow_Match_25</bpmn:incoming><bpmn:outgoing>Flow_Match_26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="A_Remind" name="Påminn hemmalaget"><bpmn:documentation>AC-107.3, notis #15 och #16.</bpmn:documentation><bpmn:incoming>Flow_Match_21</bpmn:incoming><bpmn:outgoing>Flow_Match_22</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="A_EndRemind" name="Påminnelse skickad"><bpmn:incoming>Flow_Match_22</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="A_Expired" name="MATCH_EXPIRED (Spår 1)"><bpmn:documentation>A14, 4.9. Bara i Spår 1. Reason NOT_CONFIRMED_WITHIN_48H.</bpmn:documentation><bpmn:incoming>Flow_Match_23</bpmn:incoming><bpmn:outgoing>Flow_Match_24</bpmn:outgoing><bpmn:messageEventDefinition id="A_Expired_Def" messageRef="Message_MATCH_EXPIRED" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="A_EndExpired" name="Utgången (ej bekräftad)"><bpmn:documentation>A14, AC-107.2. Status EXPIRED. Inga recensioner. Notis #17.</bpmn:documentation><bpmn:incoming>Flow_Match_24</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="A_Completed" name="MATCH_COMPLETED"><bpmn:documentation>4.8. Till Fair Play, och till Planbokning i Spår 1.</bpmn:documentation><bpmn:incoming>Flow_Match_27</bpmn:incoming><bpmn:outgoing>Flow_Match_28</bpmn:outgoing><bpmn:messageEventDefinition id="A_Completed_Def" messageRef="Message_MATCH_COMPLETED" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="A_End" name="Genomförd"><bpmn:documentation>Status COMPLETED.</bpmn:documentation><bpmn:incoming>Flow_Match_28</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="A_TimerStart" name="Starttid" attachedToRef="A_Select"><bpmn:documentation>A12</bpmn:documentation><bpmn:outgoing>Flow_Match_16</bpmn:outgoing><bpmn:timerEventDefinition id="A_TimerStart_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=match.startTime</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_MsgRevoked" name="14-dagarsfrist" attachedToRef="A_Select"><bpmn:documentation>A10. RESERVATION_REVOKED från Planbokning.</bpmn:documentation><bpmn:outgoing>Flow_Match_17</bpmn:outgoing><bpmn:messageEventDefinition id="A_MsgRevoked_Def" messageRef="Message_RESERVATION_REVOKED" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_MsgOffice" name="Inställd" attachedToRef="A_Select"><bpmn:documentation>A11. RESERVATION_CANCELLED_BY_OFFICE från Planbokning.</bpmn:documentation><bpmn:outgoing>Flow_Match_18</bpmn:outgoing><bpmn:messageEventDefinition id="A_MsgOffice_Def" messageRef="Message_RESERVATION_CANCELLED_BY_OFFICE" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_TimerRemind" name="Påminnelse" attachedToRef="A_Confirm" cancelActivity="false"><bpmn:documentation>AC-107.3. Vid sluttid och 24 h efter sluttid.</bpmn:documentation><bpmn:outgoing>Flow_Match_21</bpmn:outgoing><bpmn:timerEventDefinition id="A_TimerRemind_Def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/=match.endTime/PT24H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_Timer48" name="48 h" attachedToRef="A_Confirm"><bpmn:documentation>A14. 48 timmar efter sluttid.</bpmn:documentation><bpmn:outgoing>Flow_Match_23</bpmn:outgoing><bpmn:timerEventDefinition id="A_Timer48_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=match.endTime + duration(&quot;PT48H&quot;)</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_MsgWithdraw" name="Återbud" attachedToRef="A_Confirm"><bpmn:documentation>A7. Valt lag lämnar återbud före starttid.</bpmn:documentation><bpmn:outgoing>Flow_Match_25</bpmn:outgoing><bpmn:messageEventDefinition id="A_MsgWithdraw_Def" messageRef="Message_WITHDRAW_AS_OPPONENT" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Match_1" sourceRef="A_Start" targetRef="A_Fill" />
    <bpmn:sequenceFlow id="Flow_Match_2" sourceRef="A_Fill" targetRef="A_Auth" />
    <bpmn:sequenceFlow id="Flow_Match_3" sourceRef="A_Auth" targetRef="A_Track" />
    <bpmn:sequenceFlow id="Flow_Match_4" name="Spår 2" sourceRef="A_Track" targetRef="A_Merge" />
    <bpmn:sequenceFlow id="Flow_Match_5" name="Spår 1" sourceRef="A_Track" targetRef="A_Weekend" />
    <bpmn:sequenceFlow id="Flow_Match_6" sourceRef="A_Weekend" targetRef="A_Request" />
    <bpmn:sequenceFlow id="Flow_Match_7" sourceRef="A_Request" targetRef="A_WaitOffice" />
    <bpmn:sequenceFlow id="Flow_Match_8" sourceRef="A_WaitOffice" targetRef="A_Reserved" />
    <bpmn:sequenceFlow id="Flow_Match_9" sourceRef="A_WaitOffice" targetRef="A_Rejected" />
    <bpmn:sequenceFlow id="Flow_Match_10" sourceRef="A_Reserved" targetRef="A_Merge" />
    <bpmn:sequenceFlow id="Flow_Match_11" sourceRef="A_Rejected" targetRef="A_EndRejected" />
    <bpmn:sequenceFlow id="Flow_Match_12" sourceRef="A_Merge" targetRef="A_Publish" />
    <bpmn:sequenceFlow id="Flow_Match_13" sourceRef="A_Publish" targetRef="A_Market" />
    <bpmn:sequenceFlow id="Flow_Match_14" sourceRef="A_Market" targetRef="A_Inquire" />
    <bpmn:sequenceFlow id="Flow_Match_15" sourceRef="A_Inquire" targetRef="A_Select" />
    <bpmn:sequenceFlow id="Flow_Match_16" sourceRef="A_TimerStart" targetRef="A_EndNoOpponent" />
    <bpmn:sequenceFlow id="Flow_Match_17" sourceRef="A_MsgRevoked" targetRef="A_EndRevoked" />
    <bpmn:sequenceFlow id="Flow_Match_18" sourceRef="A_MsgOffice" targetRef="A_EndOffice" />
    <bpmn:sequenceFlow id="Flow_Match_19" sourceRef="A_Select" targetRef="A_Accepted" />
    <bpmn:sequenceFlow id="Flow_Match_20" sourceRef="A_Accepted" targetRef="A_Confirm" />
    <bpmn:sequenceFlow id="Flow_Match_21" sourceRef="A_TimerRemind" targetRef="A_Remind" />
    <bpmn:sequenceFlow id="Flow_Match_22" sourceRef="A_Remind" targetRef="A_EndRemind" />
    <bpmn:sequenceFlow id="Flow_Match_23" sourceRef="A_Timer48" targetRef="A_Expired" />
    <bpmn:sequenceFlow id="Flow_Match_24" sourceRef="A_Expired" targetRef="A_EndExpired" />
    <bpmn:sequenceFlow id="Flow_Match_25" sourceRef="A_MsgWithdraw" targetRef="A_Republish" />
    <bpmn:sequenceFlow id="Flow_Match_26" sourceRef="A_Republish" targetRef="A_Market" />
    <bpmn:sequenceFlow id="Flow_Match_27" sourceRef="A_Confirm" targetRef="A_Completed" />
    <bpmn:sequenceFlow id="Flow_Match_28" sourceRef="A_Completed" targetRef="A_End" />
    <bpmn:textAnnotation id="A_NoteCancel"><bpmn:text>Hemmalaget kan avboka före starttid (A5, A8, A9, BR-10). Status CANCELLED. I Spår 1 skickas RESERVATION_WITHDRAWN så att plantiden frigörs.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Process_Planbokning" name="Planbokning (Process B)" isExecutable="false">
    <bpmn:documentation>Planbokning för Spår 1, avsnitt 3.2. Kod: src/server/modules/reservations.ts. Status: ReservationStatus.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Planbokning">
      <bpmn:lane id="Lane_B_Office" name="Kansli">
        <bpmn:flowNodeRef>B_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndWithdrawnEarly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MsgWithdrawnEarly</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B_System" name="System">
        <bpmn:flowNodeRef>B_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Reserved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WaitAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndRemind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Revoked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndRevoked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndWithdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WaitOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MatchCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MatchExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WithdrawnLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_EndWithdrawnLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TimerRemind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Timer14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MsgWithdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="B_Start" name="REQUEST_RESERVATION"><bpmn:documentation>B1, 4.1.</bpmn:documentation><bpmn:outgoing>Flow_Planbokning_1</bpmn:outgoing><bpmn:messageEventDefinition id="B_Start_Def" messageRef="Message_REQUEST_RESERVATION" /></bpmn:startEvent>
    <bpmn:serviceTask id="B_Create" name="Skapa reservation med frist"><bpmn:documentation>B1. Status REQUESTED. Fristen = matchdatum minus 14 dagar kl 23:59:59 Europe/Stockholm.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_1</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="B_Notify" name="Meddela kansliet"><bpmn:documentation>Notis #3.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_2</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_3</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="B_Review" name="Granska förfrågan"><bpmn:documentation>AC-201.1. Kön är sorterad på datum.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_3</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="B_EndWithdrawnEarly" name="Avbokad"><bpmn:documentation>B4, AC-201.3. Status WITHDRAWN_BY_HOME. Kan inte tilldelas.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="B_Decide" name="Tilldela plan?"><bpmn:incoming>Flow_Planbokning_5</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_6</bpmn:outgoing><bpmn:outgoing>Flow_Planbokning_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="B_Allocate" name="Tilldela plan"><bpmn:documentation>B2, AC-201.2. Bara aktiva planer som klarar spelformen. Starttid och längd förifyllda. Överlapp ger en varning som kan åsidosättas.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_6</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="B_Reject" name="Avslå med orsak"><bpmn:documentation>B3, AC-204.1. Orsak krävs, högst 200 tecken.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_7</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateThrowEvent id="B_Reserved" name="RESERVATION_RESERVED"><bpmn:documentation>B2, 4.2. Status RESERVED.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_8</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_11</bpmn:outgoing><bpmn:messageEventDefinition id="B_Reserved_Def" messageRef="Message_RESERVATION_RESERVED" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="B_Rejected" name="RESERVATION_REJECTED"><bpmn:documentation>B3, 4.3. Status REJECTED_BY_OFFICE.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_9</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_10</bpmn:outgoing><bpmn:messageEventDefinition id="B_Rejected_Def" messageRef="Message_RESERVATION_REJECTED" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="B_EndRejected" name="Avslagen"><bpmn:incoming>Flow_Planbokning_10</bpmn:incoming></bpmn:endEvent>
    <bpmn:receiveTask id="B_WaitAccept" name="Vänta på vald motståndare" messageRef="Message_RESERVATION_ACCEPTED"><bpmn:documentation>B5. Väntar på RESERVATION_ACCEPTED.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_11</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_17</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:sendTask id="B_Remind" name="Påminn hemmalaget"><bpmn:documentation>AC-202.1, notis #11. Bara om planen tilldelades före påminnelsetidpunkten.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_12</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_13</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="B_EndRemind" name="Påminnelse skickad"><bpmn:incoming>Flow_Planbokning_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="B_Revoked" name="RESERVATION_REVOKED"><bpmn:documentation>B7, AC-202.2, 4.6. Status REVOKED_BY_DEADLINE. Plantiden frigörs.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_14</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_15</bpmn:outgoing><bpmn:messageEventDefinition id="B_Revoked_Def" messageRef="Message_RESERVATION_REVOKED" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="B_EndRevoked" name="Återkallad"><bpmn:incoming>Flow_Planbokning_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="B_EndWithdrawn" name="Avbokad"><bpmn:documentation>B6. Status WITHDRAWN_BY_HOME. Plantiden frigörs.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_16</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="B_Lock" name="Lås bokningen"><bpmn:documentation>B5, AC-205.1. Status ACCEPTED. Motståndarens uppgifter sparas.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_17</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:eventBasedGateway id="B_WaitOutcome" name="Vänta på matchens utgång"><bpmn:incoming>Flow_Planbokning_18</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_19</bpmn:outgoing><bpmn:outgoing>Flow_Planbokning_20</bpmn:outgoing><bpmn:outgoing>Flow_Planbokning_21</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="B_MatchCompleted" name="MATCH_COMPLETED"><bpmn:documentation>B11, AC-203.1.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_19</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_22</bpmn:outgoing><bpmn:messageEventDefinition id="B_MatchCompleted_Def" messageRef="Message_MATCH_COMPLETED" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="B_MatchExpired" name="MATCH_EXPIRED"><bpmn:documentation>B12, AC-203.3.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_20</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_23</bpmn:outgoing><bpmn:messageEventDefinition id="B_MatchExpired_Def" messageRef="Message_MATCH_EXPIRED" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="B_WithdrawnLate" name="RESERVATION_WITHDRAWN"><bpmn:documentation>B9, AC-203.2.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_21</bpmn:incoming><bpmn:outgoing>Flow_Planbokning_24</bpmn:outgoing><bpmn:messageEventDefinition id="B_WithdrawnLate_Def" messageRef="Message_RESERVATION_WITHDRAWN" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="B_End" name="Genomförd"><bpmn:documentation>Status COMPLETED. Arkiveras.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_22</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="B_EndExpired" name="Utgången"><bpmn:documentation>Status CLOSED_EXPIRED. Plantiden frigörs.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_23</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="B_EndWithdrawnLate" name="Avbokad"><bpmn:documentation>Status WITHDRAWN_BY_HOME. Plantiden frigörs.</bpmn:documentation><bpmn:incoming>Flow_Planbokning_24</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="B_MsgWithdrawnEarly" name="Avbokad" attachedToRef="B_Review"><bpmn:documentation>B4. RESERVATION_WITHDRAWN från Match.</bpmn:documentation><bpmn:outgoing>Flow_Planbokning_4</bpmn:outgoing><bpmn:messageEventDefinition id="B_MsgWithdrawnEarly_Def" messageRef="Message_RESERVATION_WITHDRAWN" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_TimerRemind" name="18 dagar" attachedToRef="B_WaitAccept" cancelActivity="false"><bpmn:documentation>AC-202.1. 18 dagar före matchdatum.</bpmn:documentation><bpmn:outgoing>Flow_Planbokning_12</bpmn:outgoing><bpmn:timerEventDefinition id="B_TimerRemind_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=reminderAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Timer14" name="14 dagar" attachedToRef="B_WaitAccept"><bpmn:documentation>B7, BR-03. Matchdatum minus 14 dagar kl 23:59:59.</bpmn:documentation><bpmn:outgoing>Flow_Planbokning_14</bpmn:outgoing><bpmn:timerEventDefinition id="B_Timer14_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=reservation.deadlineAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_MsgWithdrawn" name="Avbokad" attachedToRef="B_WaitAccept"><bpmn:documentation>B6. RESERVATION_WITHDRAWN från Match.</bpmn:documentation><bpmn:outgoing>Flow_Planbokning_16</bpmn:outgoing><bpmn:messageEventDefinition id="B_MsgWithdrawn_Def" messageRef="Message_RESERVATION_WITHDRAWN" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Planbokning_1" sourceRef="B_Start" targetRef="B_Create" />
    <bpmn:sequenceFlow id="Flow_Planbokning_2" sourceRef="B_Create" targetRef="B_Notify" />
