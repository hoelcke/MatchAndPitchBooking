    <bpmn:sequenceFlow id="Flow_Planbokning_24" sourceRef="B_WithdrawnLate" targetRef="B_EndWithdrawnLate" />
    <bpmn:textAnnotation id="B_NoteCancel"><bpmn:text>Kansliet kan ställa in en RESERVED eller ACCEPTED bokning med orsak (B10, AC-206.1). Status CANCELLED_BY_OFFICE. RESERVATION_CANCELLED_BY_OFFICE går till Match.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="B_NoteNewOpponent"><bpmn:text>Nytt RESERVATION_ACCEPTED efter återbud skriver över motståndaren utan statusändring (B8, BR-04).</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Process_FairPlay" name="Fair Play (Process C)" isExecutable="false">
    <bpmn:documentation>Fair Play-recension, avsnitt 3.3. Kod: src/server/modules/fairplay.ts. Status: ReviewStatus per recension.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_FairPlay">
      <bpmn:lane id="Lane_C_Home" name="Hemmalag">
        <bpmn:flowNodeRef>C_ReviewAway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_TimerAway</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C_Away" name="Bortalag">
        <bpmn:flowNodeRef>C_ReviewHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_TimerHome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C_System" name="System">
        <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Aggregated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C_Start" name="MATCH_COMPLETED"><bpmn:documentation>C1, 4.8.</bpmn:documentation><bpmn:outgoing>Flow_FairPlay_1</bpmn:outgoing><bpmn:messageEventDefinition id="C_Start_Def" messageRef="Message_MATCH_COMPLETED" /></bpmn:startEvent>
    <bpmn:serviceTask id="C_Create" name="Skapa två recensioner"><bpmn:documentation>C1. Status PENDING. Frist 7 kalenderdagar efter bekräftelsen.</bpmn:documentation><bpmn:incoming>Flow_FairPlay_1</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="C_Notify" name="Meddela båda ledarna"><bpmn:documentation>Notis #18.</bpmn:documentation><bpmn:incoming>Flow_FairPlay_2</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_3</bpmn:outgoing></bpmn:sendTask>
    <bpmn:parallelGateway id="C_Split"><bpmn:incoming>Flow_FairPlay_3</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_4</bpmn:outgoing><bpmn:outgoing>Flow_FairPlay_5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="C_ReviewAway" name="Recensera bortalaget"><bpmn:documentation>C2, AC-301.3. Delbetyg 1–3 för spelare, ledare och publik samt bedömd nivå. Status SUBMITTED, dold (BR-05).</bpmn:documentation><bpmn:incoming>Flow_FairPlay_4</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="C_ReviewHome" name="Recensera hemmalaget"><bpmn:documentation>C2, AC-301.3. Status SUBMITTED, dold (BR-05).</bpmn:documentation><bpmn:incoming>Flow_FairPlay_5</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="C_Join"><bpmn:incoming>Flow_FairPlay_6</bpmn:incoming><bpmn:incoming>Flow_FairPlay_7</bpmn:incoming><bpmn:incoming>Flow_FairPlay_8</bpmn:incoming><bpmn:incoming>Flow_FairPlay_9</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="C_Publish" name="Publicera och räkna om lagprofiler"><bpmn:documentation>C3, C4, C5, BR-13, AC-303.1. Inlämnade blir PUBLISHED, övriga EXPIRED. Median av nivå och snitt av Fair Play över senaste 10, visas från 3.</bpmn:documentation><bpmn:incoming>Flow_FairPlay_10</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="C_Aggregated" name="REVIEW_AGGREGATED"><bpmn:documentation>4.10.</bpmn:documentation><bpmn:incoming>Flow_FairPlay_11</bpmn:incoming><bpmn:outgoing>Flow_FairPlay_12</bpmn:outgoing><bpmn:messageEventDefinition id="C_Aggregated_Def" messageRef="Message_REVIEW_AGGREGATED" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="C_End" name="Klar"><bpmn:incoming>Flow_FairPlay_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="C_TimerAway" name="7 dagar" attachedToRef="C_ReviewAway"><bpmn:documentation>C4, C5</bpmn:documentation><bpmn:outgoing>Flow_FairPlay_8</bpmn:outgoing><bpmn:timerEventDefinition id="C_TimerAway_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=reviewDeadlineAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="C_TimerHome" name="7 dagar" attachedToRef="C_ReviewHome"><bpmn:documentation>C4, C5</bpmn:documentation><bpmn:outgoing>Flow_FairPlay_9</bpmn:outgoing><bpmn:timerEventDefinition id="C_TimerHome_Def"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=reviewDeadlineAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_FairPlay_1" sourceRef="C_Start" targetRef="C_Create" />
    <bpmn:sequenceFlow id="Flow_FairPlay_2" sourceRef="C_Create" targetRef="C_Notify" />
    <bpmn:sequenceFlow id="Flow_FairPlay_3" sourceRef="C_Notify" targetRef="C_Split" />
    <bpmn:sequenceFlow id="Flow_FairPlay_4" sourceRef="C_Split" targetRef="C_ReviewAway" />
    <bpmn:sequenceFlow id="Flow_FairPlay_5" sourceRef="C_Split" targetRef="C_ReviewHome" />
    <bpmn:sequenceFlow id="Flow_FairPlay_6" name="Inlämnad" sourceRef="C_ReviewAway" targetRef="C_Join" />
    <bpmn:sequenceFlow id="Flow_FairPlay_7" name="Inlämnad" sourceRef="C_ReviewHome" targetRef="C_Join" />
    <bpmn:sequenceFlow id="Flow_FairPlay_8" name="Utgår" sourceRef="C_TimerAway" targetRef="C_Join" />
    <bpmn:sequenceFlow id="Flow_FairPlay_9" name="Utgår" sourceRef="C_TimerHome" targetRef="C_Join" />
    <bpmn:sequenceFlow id="Flow_FairPlay_10" sourceRef="C_Join" targetRef="C_Publish" />
    <bpmn:sequenceFlow id="Flow_FairPlay_11" sourceRef="C_Publish" targetRef="C_Aggregated" />
    <bpmn:sequenceFlow id="Flow_FairPlay_12" sourceRef="C_Aggregated" targetRef="C_End" />
  </bpmn:process>
