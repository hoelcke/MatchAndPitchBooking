      <dmndi:DMNEdge id="IR_helgtid_in_requestedDate_di" dmnElementRef="IR_helgtid_in_requestedDate"><di:waypoint x="420" y="470" /><di:waypoint x="420" y="405" /><di:waypoint x="390" y="405" /><di:waypoint x="390" y="340" /></dmndi:DMNEdge>
