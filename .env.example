# Port för API-servern (Vite-devservern proxar /api hit)
PORT=3000
# Sökväg till SQLite-databasen
DATABASE_PATH=data/matchborsen.db
# Google Identity Services. Utan värde visas bara dev-inloggningen.
GOOGLE_CLIENT_ID=
# Komma-separerade e-postadresser som får rollen kansli resp. administratör vid första Google-inloggningen
OFFICE_EMAILS=
ADMIN_EMAILS=
# Dev-verktyg (inloggningsväxlare, tidsmaskin, utkorg). Alltid av när NODE_ENV=production om inte satt till true.
ENABLE_DEV_TOOLS=
