      <dmndi:DMNEdge id="IR_anmalan_in_inquiringTeam_di" dmnElementRef="IR_anmalan_in_inquiringTeam"><di:waypoint x="840" y="470" /><di:waypoint x="840" y="315" /><di:waypoint x="890" y="315" /><di:waypoint x="890" y="160" /></dmndi:DMNEdge>
      <dmndi:DMNEdge id="IR_avbokning_in_match_di" dmnElementRef="IR_avbokning_in_match"><di:waypoint x="1070" y="470" /><di:waypoint x="1070" y="315" /><di:waypoint x="1090" y="315" /><di:waypoint x="1090" y="160" /></dmndi:DMNEdge>
      <dmndi:DMNEdge id="IR_recension_in_reviews_di" dmnElementRef="IR_recension_in_reviews"><di:waypoint x="1370" y="285" /><di:waypoint x="1370" y="222" /><di:waypoint x="1340" y="222" /><di:waypoint x="1340" y="160" /></dmndi:DMNEdge>
      <dmndi:DMNEdge id="IR_lagprofil_in_profile_di" dmnElementRef="IR_lagprofil_in_profile"><di:waypoint x="1620" y="285" /><di:waypoint x="1620" y="222" /><di:waypoint x="1590" y="222" /><di:waypoint x="1590" y="160" /></dmndi:DMNEdge>
      <dmndi:DMNEdge id="IR_planErbjuds_in_pitch_di" dmnElementRef="IR_planErbjuds_in_pitch"><di:waypoint x="1370" y="605" /><di:waypoint x="1370" y="542" /><di:waypoint x="1340" y="542" /><di:waypoint x="1340" y="480" /></dmndi:DMNEdge>
      <dmndi:DMNEdge id="IR_akut_in_event_di" dmnElementRef="IR_akut_in_event"><di:waypoint x="1620" y="605" /><di:waypoint x="1620" y="542" /><di:waypoint x="1590" y="542" /><di:waypoint x="1590" y="480" /></dmndi:DMNEdge>
