      <dmndi:DMNEdge id="IR_anmalan_kompatibel_di" dmnElementRef="IR_anmalan_kompatibel"><di:waypoint x="740" y="260" /><di:waypoint x="740" y="210" /><di:waypoint x="890" y="210" /><di:waypoint x="890" y="160" /></dmndi:DMNEdge>
